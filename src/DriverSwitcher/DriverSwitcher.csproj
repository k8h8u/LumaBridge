<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LumaBridge</AssemblyName>
    <RootNamespace>DriverSwitcher</RootNamespace>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>0.2.0</Version>
    <Product>LUMABRIDGE</Product>
    <Description>Переключение драйверов BJJCZ EzCAD2/LightBurn и перенос макетов</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\drivers\ezcad2\*">
      <Link>Drivers\ezcad2\%(Filename)%(Extension)</Link>
      <LogicalName>DriverSwitcher.Drivers.ezcad2.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\drivers\winusb\*">
      <Link>Drivers\winusb\%(Filename)%(Extension)</Link>
      <LogicalName>DriverSwitcher.Drivers.winusb.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\DriverSwitcher.cer">
      <LogicalName>DriverSwitcher.Assets.DriverSwitcher.cer</LogicalName>
    </EmbeddedResource>
    <Resource Include="Assets\LuminoLogo.png"/>
  </ItemGroup>

</Project>
