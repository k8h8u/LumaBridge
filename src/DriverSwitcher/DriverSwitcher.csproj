<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DriverSwitcher</AssemblyName>
    <RootNamespace>DriverSwitcher</RootNamespace>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.0</Version>
    <Product>DriverSwitcher</Product>
    <Description>Переключение драйверов плат BJJCZ между EzCAD2 и LightBurn</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\drivers\ezcad2\*">
      <Link>Drivers\ezcad2\%(Filename)%(Extension)</Link>
      <LogicalName>DriverSwitcher.Drivers.ezcad2.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\drivers\winusb\*">
      <Link>Drivers\winusb\%(Filename)%(Extension)</Link>
      <LogicalName>DriverSwitcher.Drivers.winusb.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\DriverSwitcher.cer">
      <LogicalName>DriverSwitcher.Assets.DriverSwitcher.cer</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
